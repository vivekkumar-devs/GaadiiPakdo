<?xml version="1.0" encoding="utf-8"?>

<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/drawerLayout"
android:layout_width="match_parent"
android:layout_height="match_parent">

<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <!-- ================= MAP ================= -->

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Dark Overlay -->

    <!-- NO DRIVER LAYOUT -->
    <LinearLayout
        android:id="@+id/noDriverLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:background="#EAF5FF"
        android:visibility="gone">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_marginBottom="150dp"
            android:src="@drawable/no_driver" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-140dp"
            android:text="No drivers available"
            android:textColor="#0D47A1"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="We couldn't find any available drivers right now."
            android:textColor="#666666"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- ================= TOP BAR ================= -->

    <!-- 🔙 Menu Button -->
    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="38dp"
        android:background="@drawable/bg_circle_white"
        android:src="@drawable/outline_menu"
        android:tint="#000000"
        android:elevation="8dp"
        android:padding="12dp" />

    <!-- 🚪 Logout -->
    <ImageButton
        android:id="@+id/btnNotification"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="38dp"
        android:background="@drawable/bg_circle_white"
        android:src="@drawable/outline_notification"
        android:tint="#000000"
        android:elevation="8dp"
        android:padding="12dp" />

    <TextView
        android:id="@+id/txtStatus"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="Waiting for vehicle"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#000"
        android:background="@drawable/bg_status_pill"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:gravity="center"
        android:elevation="10dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="70dp" />

    <!-- ================= BOTTOM DRIVER CARD ================= -->

    <LinearLayout
        android:id="@+id/vehicleCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_margin="0dp"
        android:background="@drawable/bg_bottom_card"
        android:elevation="10dp"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ================= TOP SECTION ================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Driver Image -->

            <ImageView
                android:id="@+id/imgDriver"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_driver_image"
                android:padding="3dp"
                android:scaleType="centerCrop"
                android:src="@drawable/driverimg11"/>

            <!-- Driver Details -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtDriverName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Driver: --"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- Vehicle -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_car_white"/>

                    <TextView
                        android:id="@+id/txtVehicleNumber"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Vehicle: --"
                        android:textColor="#C9D6FF"
                        android:textSize="10sp"/>

                </LinearLayout>

                <!-- Capacity -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_capacity"/>

                    <TextView
                        android:id="@+id/txtCapacity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Capacity: --"
                        android:textColor="#C9D6FF"
                        android:textSize="10sp"/>

                </LinearLayout>

                <!-- Updated -->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_clock_gray"/>

                    <TextView
                        android:id="@+id/txtLastUpdated"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Updated: --"
                        android:textColor="#C9D6FF"
                        android:textSize="10sp"/>

                </LinearLayout>



            </LinearLayout>

            <!-- Call Button -->

            <ImageButton
                android:id="@+id/callDriverBtn"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_call_button"
                android:padding="14dp"
                android:scaleType="centerInside"
                android:src="@drawable/call_icon_hd"
                android:tint="@android:color/white"/>

        </LinearLayout>

        <!-- Divider -->

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#244B84"/>

        <!-- ================= STATS ================= -->

        <LinearLayout
            android:id="@+id/infoCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- Distance -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/distanceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Distance"
                    android:textColor="#9CAFD2"
                    android:textSize="12sp"/>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="9dp"
                    android:src="@drawable/ic_location_blue"/>

            </LinearLayout>

            <!-- Divider -->

            <View
                android:layout_width="1dp"
                android:layout_height="80dp"
                android:background="#244B84"/>

            <!-- ETA -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:textColor="#9CAFD2"
                    android:textSize="12sp"/>

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginTop="9dp"
                    android:src="@drawable/outline_time"/>

            </LinearLayout>

            <!-- Divider -->

            <View
                android:layout_width="1dp"
                android:layout_height="80dp"
                android:background="#244B84"/>

            <!-- Speed -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Speed"
                    android:textColor="#9CAFD2"
                    android:textSize="12sp"/>

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginTop="9dp"
                    android:src="@drawable/outline_speed"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
    <include
        android:id="@+id/drawerMenu"
        layout="@layout/drawer_menu"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"/>
</androidx.drawerlayout.widget.DrawerLayout>