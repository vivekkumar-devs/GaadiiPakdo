<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- ========================= -->
            <!-- Title -->
            <!-- ========================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="User Registration"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_marginBottom="8dp" />

            <!-- Subtitle -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Register using phone number"
                android:textSize="14sp"
                android:textColor="#607D8B"
                android:gravity="center"
                android:layout_marginBottom="24dp" />

            <!-- ========================= -->
            <!-- Full Name -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Full Name"
                android:padding="14dp"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="@drawable/edit_bg"
                android:textSize="15sp"
                android:inputType="textPersonName"
                android:layout_marginBottom="16dp" />

            <!-- ========================= -->
            <!-- Phone Number -->
            <!-- ========================= -->

            <EditText
                android:id="@+id/userPhone"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="Phone Number"
                android:inputType="phone"
                android:maxLength="10"
                android:padding="14dp"
                android:textColor="#000000"
                android:textColorHint="#888888"
                android:background="@drawable/edit_bg"
                android:textSize="15sp"
                android:layout_marginBottom="16dp" />

            <!-- ========================= -->
            <!-- Password -->
            <!-- ========================= -->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/passworddd"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Password"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="50dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:background="@drawable/edit_bg"
                    android:textSize="15sp"/>

                <ImageView
                    android:id="@+id/passwordToggle"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="2dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_visibility"
                    />

            </RelativeLayout>
            <!-- ========================= -->
            <!-- Confirm Password -->
            <!-- ========================= -->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="20dp">

                <EditText
                    android:id="@+id/confirmPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Confirm Password"
                    android:inputType="textPassword"
                    android:paddingStart="14dp"
                    android:paddingEnd="50dp"
                    android:textColor="#000000"
                    android:textColorHint="#888888"
                    android:background="@drawable/edit_bg"
                    android:textSize="15sp"/>

                <ImageView
                    android:id="@+id/confirmPasswordToggle"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="2dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ic_visibility"
                    />

            </RelativeLayout>

            <!-- ========================= -->
            <!-- Password Requirements -->
            <!-- ========================= -->

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardBackgroundColor="#EEF4FF"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_shield_login"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Password must contain:"
                            android:textStyle="bold"
                            android:textColor="#0C1B57"
                            android:textSize="14sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <!-- Left Column -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/registerRuleLength"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_check_circle_blue"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="At least 8 characters"
                                    android:textColor="#50607D"
                                    android:textSize="12sp"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/registerRuleUppercase"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_check_circle_blue"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="One uppercase letter"
                                    android:textColor="#50607D"
                                    android:textSize="12sp"/>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Right Column -->

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/registerRuleNumber"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_check_circle_blue"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="One number"
                                    android:textColor="#50607D"
                                    android:textSize="12sp"/>

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical">

                                <ImageView
                                    android:id="@+id/registerRuleSpecial"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_check_circle_blue"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="One special character"
                                    android:textColor="#50607D"
                                    android:textSize="12sp"/>

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>


            <!-- ========================= -->
            <!-- Register Button -->
            <!-- ========================= -->

            <Button
                android:id="@+id/registerBtn"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Register"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:backgroundTint="#2563FF"
                android:layout_marginBottom="20dp" />

            <!-- ========================= -->
            <!-- Login Link -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/tvuserlogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="15sp"
                android:textColor="#6B7280"
                android:textStyle="normal"
                android:text="Already have an account?"/>

            <!-- Fixed/Scroll Footer -->
        </LinearLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>