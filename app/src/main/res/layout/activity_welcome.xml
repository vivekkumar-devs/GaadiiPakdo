<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- ===================================================== -->
    <!-- Responsive Guidelines                                 -->
    <!-- ===================================================== -->

    <!-- 7% from top -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/topGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.07"/>

    <!-- Left -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/startGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="12dp"/>

    <!-- Right -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/endGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="12dp"/>

    <!-- ===================================================== -->
    <!-- Welcome Title                                         -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome"
        android:textColor="@color/text_dark"
        android:textStyle="bold"
        android:textSize="34sp"
        android:fontFamily="sans-serif-medium"

        app:layout_constraintTop_toBottomOf="@id/topGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===================================================== -->
    <!-- Subtitle                                               -->
    <!-- ===================================================== -->

    <TextView
        android:id="@+id/txtSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Sign in or create a new account"
        android:textColor="#607D8B"
        android:textSize="15sp"

        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ===================================================== -->
    <!-- ViewFlipper starts here                               -->
    <!-- Part 1B continues from this point                     -->
    <!-- ===================================================== -->

    <!-- ===================================================== -->
    <!-- Responsive Image Slider -->
    <!-- ===================================================== -->

    <ViewFlipper
        android:id="@+id/viewFlipper"
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:autoStart="true"
        android:flipInterval="3000"

        android:animateFirstView="true"
        android:measureAllChildren="true"

        android:inAnimation="@anim/slide_fade_in"
        android:outAnimation="@anim/slide_fade_out"

        android:minHeight="180dp"
        android:maxHeight="300dp"

        android:layout_marginTop="24dp"

        app:layout_constraintTop_toBottomOf="@id/txtSub"
        app:layout_constraintStart_toStartOf="@id/startGuide"
        app:layout_constraintEnd_toEndOf="@id/endGuide"

        app:layout_constraintWidth_percent="1.0"

        app:layout_constraintDimensionRatio="16:10">

        <!-- Image 1 -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/img1" />

        <!-- Image 2 -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/img2" />

        <!-- Image 3 -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/img3" />

        <!-- Image 4 -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/img4" />

    </ViewFlipper>

    <!-- ===================================================== -->
    <!-- User Card starts here -->
    <!-- Continue with Part 2 -->
    <!-- ===================================================== -->
    <!-- USER CARD -->

    <!-- ===================================================== -->
    <!-- PART 2A - RESPONSIVE USER CARD -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/userCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="104dp"
        android:layout_marginTop="20dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="#DCEBFF"
        app:layout_constraintTop_toBottomOf="@id/viewFlipper"
        app:layout_constraintStart_toStartOf="@id/startGuide"
        app:layout_constraintEnd_toEndOf="@id/endGuide">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_ripple">

            <!-- Blue Strip -->

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="#2563FF"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="104dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- User Icon -->

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_user_icon"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/imgUser"
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/user_icon_111"/>

                </FrameLayout>

                <!-- Divider -->

                <View
                    android:layout_width="1dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="14dp"
                    android:background="#DCE5F7"/>

                <!-- Text -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I'm a User"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Book rides quickly and easily"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"
                        android:maxLines="2"/>

                </LinearLayout>

                <!-- Arrow -->

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/ic_next_welcome_blue">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_forward_welcome"/>

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ===================================================== -->
    <!-- DRIVER CARD STARTS HERE -->
    <!-- Continue with Part 2B -->
    <!-- ===================================================== -->
    <!-- DRIVER CARD -->

    <!-- ===================================================== -->
    <!-- PART 2B - RESPONSIVE DRIVER CARD -->
    <!-- ===================================================== -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/driverCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="104dp"
        android:layout_marginTop="16dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardCornerRadius="22dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="#DCEBFF"

        app:layout_constraintTop_toBottomOf="@id/userCard"
        app:layout_constraintBottom_toTopOf="@id/footerCard"
        app:layout_constraintVertical_bias="0"

        app:layout_constraintStart_toStartOf="@id/startGuide"
        app:layout_constraintEnd_toEndOf="@id/endGuide">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_ripple_driver">

            <!-- Left Yellow Strip -->

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="#FFC107"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="104dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <!-- Driver Icon -->

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_driver_icon"
                    android:padding="4dp">

                    <ImageView
                        android:id="@+id/imgDriver"
                        android:layout_width="85dp"
                        android:layout_height="85dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/driver_icon_111"/>

                </FrameLayout>

                <!-- Divider -->

                <View
                    android:layout_width="1dp"
                    android:layout_height="46dp"
                    android:layout_marginHorizontal="14dp"
                    android:background="#DCE5F7"/>

                <!-- Text -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I'm a Driver"
                        android:textColor="@color/text_dark"
                        android:textStyle="bold"
                        android:textSize="18sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:maxLines="2"
                        android:text="Earn money by offering rides"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp"/>

                </LinearLayout>

                <!-- Arrow -->

                <FrameLayout
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/ic_next_welcome_yellow">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_arrow_forward_welcome"/>

                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ===================================================== -->
    <!-- FOOTER STARTS HERE -->
    <!-- Continue with Part 3 -->
    <!-- ===================================================== -->
    <!-- ===================================================== -->
    <!-- PART 3 - RESPONSIVE FOOTER -->
    <!-- ===================================================== -->
    <!-- Fixed Footer -->

    <androidx.cardview.widget.CardView
        android:id="@+id/footerCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:cardCornerRadius="19dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F4F8FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="1dp">

            <!-- SAFE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="1dp">

                <FrameLayout
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/bg_blue_box"
                    android:padding="2dp">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_shield_login"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Safe"
                        android:textColor="#0C1B57"
                        android:textSize="10sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Your Safety&#10;Is Our Priority"
                        android:textColor="#50607D"
                        android:textSize="5sp"/>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:background="#DCE5F7"/>

            <!-- FAST -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="14dp">

                <FrameLayout
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/bg_blue_box"
                    android:padding="2dp">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_flash"/>
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fast"
                        android:textColor="#0C1B57"
                        android:textSize="10sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Rides,&#10;Save Time"
                        android:textColor="#50607D"
                        android:textSize="5sp"/>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="34dp"
                android:background="#DCE5F7"/>

            <!-- RELIABLE -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:paddingStart="14dp">

                <FrameLayout
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:background="@drawable/bg_blue_box"
                    android:padding="2dp">
                    <ImageView
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_gravity="center"
                        android:scaleType="fitCenter"
                        android:src="@drawable/hd_icon2"/>
                </FrameLayout>



                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reliable"
                        android:textColor="#0C1B57"
                        android:textSize="10sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dependable Rides,&#10;Everytime"
                        android:textColor="#50607D"
                        android:textSize="5sp"/>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
